# Template Alertmanager. File final alertmanager.yml dibuat oleh
# ops/lab/monitor-vm-setup.sh (mengisi placeholder URL webhook ntfy);
# jangan di-commit.
#
# Notifikasi dikirim ke ntfy.sh (push notification gratis tanpa akun).
# Parameter email pada URL membuat ntfy.sh juga meneruskan alert ke email.
route:
  receiver: ntfy
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 2m
  repeat_interval: 3h
  routes:
    - matchers: [severity="critical"]
      receiver: ntfy
      group_wait: 10s
      repeat_interval: 1h

receivers:
  - name: ntfy
    webhook_configs:
      - url: "__NTFY_URL__"
        send_resolved: true
        max_alerts: 10

inhibit_rules:
  # Saat layanan down (critical), redam alert latensi untuk endpoint yang sama
  - source_matchers: [alertname="LayananTidakTersedia"]
    target_matchers: [alertname="WaktuResponsLambat"]
    equal: [instance]
