# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://curalyta:curalyta@localhost:5432/curalyta?schema=public"

# ============================================================
# SERVER
# ============================================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ============================================================
# AUTH
# ============================================================
# Generate strong secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-secret-min-32-chars-for-production"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ============================================================
# DEFAULT ADMIN (created by seed)
# ============================================================
ADMIN_EMAIL=admin@curalyta.app
ADMIN_PASSWORD=Curalyta#2025

# ============================================================
# GROQ AI (optional — platform runs fully without this)
# ============================================================
# Dipakai oleh Doctor AI (rekomendasi/ringkasan pasien) dan Tanya AI publik.
# Isi satu atau beberapa key dipisah koma; key dirotasi per request dan
# otomatis pindah ke key berikutnya saat kena rate limit (429) atau ditolak.
# Get key from: https://console.groq.com/keys
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
PUBLIC_AI_IMAGE_MAX_MB=5

# ============================================================
# FILE UPLOADS
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
