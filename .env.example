# ============================================================
# Curalyta — environment variables (docker compose & backend)
#
# Copy to .env and fill in. NEVER commit .env.
# Generate strong random values with:
#   openssl rand -hex 32        (passwords)
#   openssl rand -hex 64        (JWT_SECRET)
# ============================================================

# --- Images (VM pulls from Artifact Registry; local builds use :local) ---
BACKEND_IMAGE=curalyta-backend:local
FRONTEND_IMAGE=curalyta-frontend:local

# --- Reverse proxy ---
# SERVER_NAME : public hostname, e.g. 34-101-1-2.sslip.io ("_" for local)
# NGINX_SITE  : http (local / before certificate) or https (production)
SERVER_NAME=_
NGINX_SITE=http
HTTP_PORT=80
HTTPS_PORT=443
CERTBOT_WEBROOT=./.certbot/www
LETSENCRYPT_DIR=./.certbot/conf

# --- Database (PostgreSQL container) ---
POSTGRES_USER=curalyta
POSTGRES_PASSWORD=
POSTGRES_DB=curalyta

# --- Backend ---
# Comma-separated list of allowed browser origins
# (production URL + Vercel staging URL)
CORS_ORIGIN=http://localhost
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@curalyta.app
ADMIN_PASSWORD=

# --- Groq AI (optional; several keys comma-separated, rotated per request) ---
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
PUBLIC_AI_IMAGE_MAX_MB=5

# --- Limits ---
MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# --- Backups (ops/backup-db.sh) ---
BACKUP_BUCKET=
BACKUP_DIR=/var/backups/curalyta
BACKUP_S3_ENDPOINT=http://192.168.45.30:3900
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Deploy (ops/deploy.sh) ---
# Container registry for images built by GitHub Actions
REGISTRY=ghcr.io/muhammadabrarrayhan2/curalyta
