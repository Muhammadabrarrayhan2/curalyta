- compress: zstd
  enabled: 1
  id: curalyta-daily
  mode: snapshot
  next-run: 1792953000
  notes-template: '{{guestname}} harian'
  prune-backups:
    keep-last: '2'
  schedule: 01:30
  storage: backup-disk
  type: vzdump
  vmid: 101,102

